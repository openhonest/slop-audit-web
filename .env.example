# Slop Audit web config. Copy to .env to override. All values are read once, at startup, in app/config.py.
CLONE_TIMEOUT_SECONDS=45
ANALYZE_TIMEOUT_SECONDS=60
WORK_DIR=/tmp/slop-audit-web

# Reject repos larger than this (GitHub reports size in KB; 300000 KB = ~300 MB).
MAX_REPO_SIZE_KB=300000

# Optional. Without a token the pre-clone size check uses the unauthenticated
# GitHub API (60 requests/hour/IP); a token raises that to 5000/hour. Absence is
# fine: on any API failure the size check is skipped and the clone timeout is the
# backstop. A read-only (public_repo / no-scope) token is plenty.
# GITHUB_TOKEN=

# Origin rate-limit backstop (Cloudflare does the real edge limiting).
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
